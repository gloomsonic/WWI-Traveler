# Ignore .yy files for language statistics
*.yy linguist-generated=true
 
# force LF for metadata files for merge simplicity
*.gml text eol=lf
*.yy text eol=lf
*.yyp text eol=lf
*.json text eol=lf

# Binary assets — NEVER apply text/EOL conversion (it corrupts them).
# FMOD banks were mangled once already because they weren't marked binary.
*.bank binary
*.dylib binary
*.dll binary
*.ogg binary
*.wav binary
*.png binary

# Shell scripts must be LF so the FMOD build's `sed 's/\r$//'` has nothing to strip
# (otherwise the .sh files show as modified after every build).
*.sh text eol=lf